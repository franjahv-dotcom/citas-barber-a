# Opcional: copia este archivo a .env para cambiar la conexión.
PORT=3001
HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=barberia_db
# En el primer arranque se genera una contraseña aleatoria en .admin-access.txt.
# Para fijar credenciales iniciales en una base nueva, descomenta y cambia:
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=ReemplazarConUnaClaveDe12CaracteresOMas
# Habilitar solo si la aplicación se sirve por HTTPS:
COOKIE_SECURE=false
